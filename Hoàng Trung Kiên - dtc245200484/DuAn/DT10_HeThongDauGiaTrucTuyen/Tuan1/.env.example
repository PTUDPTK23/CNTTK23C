# Copy to .env before running `docker compose up --build`.
# These are development-only defaults. Use strong, unique values outside local development.

POSTGRES_PASSWORD=auction_dev_password
RABBITMQ_PASSWORD=auction_dev_password

# Must be at least 32 characters (HS256).
JWT_KEY=dev-only-signing-key-change-me-online-auction-2026

# Shared key for HubConsumer -> API internal broadcast endpoints.
INTERNAL_API_KEY=dev-internal-key-change-me

# Browser-facing URL of the API (used when the frontend is built).
PUBLIC_API_URL=http://localhost:5100

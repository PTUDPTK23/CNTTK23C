
@baseUrl = http://localhost:5100

### 1. GET - Kiem tra trang thai API (200 OK)
GET {{baseUrl}}/

### 2. GET - Lay danh sach san pham (200 OK)
GET {{baseUrl}}/api/products

### 3. GET - Lay san pham co ID = 1 (200 OK)
GET {{baseUrl}}/api/products/1

### 4. GET - ID khong ton tai (404 Not Found)
GET {{baseUrl}}/api/products/999

### 5. GET - ID khong hop le (404 Not Found)
GET {{baseUrl}}/api/products/abc

### 6. POST - Tao san pham hop le (201 Created)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "San pham tu requests.http",
  "description": "Kiem thu tao san pham moi",
  "price": 180000
}

### 7. POST - Gia am, du lieu khong hop le (400 Bad Request)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "San pham loi",
  "description": "Kiem tra validation",
  "price": -100
}

### 8. POST - Thieu Content-Type (415 Unsupported Media Type)
POST {{baseUrl}}/api/products

{
  "name": "San pham thieu Content-Type",
  "description": "Kiem tra loi HTTP 415",
  "price": 100000
}
